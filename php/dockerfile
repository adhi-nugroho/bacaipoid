FROM dunglas/frankenphp:php8.4.27-alpine AS base

# Install PHP extensions via official script
RUN install-php-extensions \
    pdo_mysql \
    redis \
    opcache \
    intl \
    zip \
    bcmath \
    pcntl \
    && rm -rf /tmp/* /var/cache/apk/*

# Official images for tooling
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
COPY --from=oven/bun:alpine /usr/local/bin/bun /usr/local/bin/bun

RUN apk add --no-cache \
    bash \
    curl \
    unzip \
    libcurl \
    python3 \
    py3-pip

COPY python/requirements.txt /tmp/requirements.txt

RUN apk add --no-cache --virtual .build-deps \
    build-base \
    python3-dev \
    curl-dev \
    nghttp2-dev \
    libffi-dev \
    && python3 -m venv /opt/ipo-venv \
    && /opt/ipo-venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
    && apk del .build-deps \
    && rm -rf /tmp/* /var/cache/apk/*

ENV PYTHON_VENV=/opt/ipo-venv

WORKDIR /app

ENTRYPOINT []

# ─────────────────────────────────────────
# Dev
# ─────────────────────────────────────────
FROM base AS dev

CMD ["php","artisan","octane:start","--host=0.0.0.0","--port=8000","--watch"]

# ─────────────────────────────────────────
# Prod
# ─────────────────────────────────────────
FROM base AS prod

# 1. Dependency definitions first for layer caching
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-autoloader \
    --no-scripts

COPY package.json bun.lock* ./
RUN bun install

# 2. Application source code
COPY . .

# 3. Optimize autoload & build assets
RUN composer dump-autoload --optimize --no-dev \
    && bun run build \
    && rm -rf node_modules

RUN php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache

EXPOSE 8000

CMD ["php","artisan","octane:frankenphp","--host=0.0.0.0","--port=8000","--max-requests=550","--caddyfile=Caddyfile"]
